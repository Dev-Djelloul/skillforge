{
  "name": "skillforge",
  "version": "0.1.0",
  "private": true,
  "description": "SkillForge — agent IA d'entraînement aux entretiens techniques (IA, gestion de projet digital, dev web, culture numérique)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute skillforge-db --local --file=./src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute skillforge-db --remote --file=./src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute skillforge-db --local --file=./src/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute skillforge-db --remote --file=./src/db/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
